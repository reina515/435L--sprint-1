        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_id\": 2,\n    \"title\": \"New incident assigned\",\n    \"message\": \"Incident #12 (phishing email) has been assigned to you.\",\n    \"notification_type\": \"Incident Assignment\",\n    \"severity\": \"High\"\n}",
