# ===== Example only - run `python setup_env.py` to create the real .env =====
# Your full name: shown in the X-Student-Name header of every API response
STUDENT_NAME=Your Full Name

# --- Secrets ---
JWT_SECRET=generate-with-setup_env.py
FERNET_KEY=generate-with-setup_env.py
HMAC_KEY=generate-with-setup_env.py
SERVICE_API_KEY=generate-with-setup_env.py

# --- Token lifetime ---
JWT_EXPIRES_MINUTES=60

# --- Database (relative to the project root) ---
DATABASE_PATH=database/security.db

# --- Services ---
HOST=127.0.0.1
USER_SERVICE_PORT=5001
AUDIT_SERVICE_PORT=5005
NOTIFICATION_SERVICE_PORT=5008

# --- Security options ---
MAX_FAILED_LOGINS=5
FLASK_DEBUG=false
# Set to true after running `python generate_cert.py` to serve the APIs over HTTPS
USE_HTTPS=false
